<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/news_card_root"
    android:layout_width="170dp"
    android:layout_height="170dp"
    android:background="@drawable/bg_sports_card"
    android:clickable="false"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- News Header Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_news_card_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="📰 Actualités"
            android:textColor="#C0FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_news_card_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Direct"
            android:textColor="#80FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- News Headline Text in Center -->
    <TextView
        android:id="@+id/text_widget_news"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:textColor="#F5FFFFFF"
        android:textSize="12sp"
        tools:text="Sommet mondial sur le climat : un accord historique trouvé sur la réduction des émissions..." />

    <!-- Source and Category Footer -->
    <TextView
        android:id="@+id/text_news_card_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:singleLine="true"
        android:text="Google News"
        android:textColor="#80FFFFFF"
        android:textSize="10sp" />

</LinearLayout>
