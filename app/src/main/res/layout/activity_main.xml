<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Scenic Wallpaper Background (Bing 4K / Alpine Lake / Storage / Google Photos) -->
    <ImageView
        android:id="@+id/image_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_default_scenic" />

    <!-- Top Shelf Backdrop Layer (Promoted poster art for hovered dock/drawer app) -->
    <ImageView
        android:id="@+id/image_top_shelf_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />


    <!-- Dark Contrast Scrim for WCAG 4.5:1 text compliance -->
    <View
        android:id="@+id/view_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#350A101C" />

    <!-- ======================================================== -->
    <!-- STICKY TOP HEADER BAR: Always pinned at the top          -->
    <!-- Flex-like responsive layout: Date & Time never overlap   -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/top_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="44dp"
        android:paddingTop="26dp"
        android:paddingEnd="44dp"
        android:paddingBottom="12dp">

        <!-- Left: Clock and Date inline -->
        <LinearLayout
            android:id="@+id/layout_clock_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/text_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/text_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:singleLine="true"
                android:textColor="#D0FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Right: Status Capsules -->
        <LinearLayout
            android:id="@+id/layout_status_capsules"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <!-- Capsule 1: RAM Free -->
            <LinearLayout
                android:id="@+id/widget_ram_container"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_capsule_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/text_widget_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    tools:text="RAM: 1.2G libre" />
            </LinearLayout>

                        <!-- Capsule 3: Weather -->
            <LinearLayout
                android:id="@+id/widget_weather_container"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_capsule_pill"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/icon_widget_weather"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_weather"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/text_widget_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxWidth="160dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:text="21°C" />
            </LinearLayout>

            <!-- Capsule 4: Settings Button with tvOS Overshoot & Halo -->
            <FrameLayout
                android:id="@+id/btn_settings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_settings_pill_selector"
                android:clickable="true"
                android:contentDescription="@string/settings_title"
                android:elevation="4dp"
                android:focusable="true"
                android:nextFocusDown="@id/recycler_favorites">

                <ImageView
                    android:id="@+id/icon_settings"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- TIER 1: AT REST / HOME SCREEN                            -->
    <!-- Scenic Wallpaper + Centered News Ticker + Bottom Dock    -->
    <!-- ======================================================== -->

    <!-- SQUARE SPORTS CARD WIDGET: Live Scores with Team Logos -->
    <FrameLayout
        android:id="@+id/widget_sports_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="44dp"
        android:clickable="false"
        android:descendantFocusability="blocksDescendants"
        android:elevation="12dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone">

        <include
            android:id="@+id/sports_card_view"
            layout="@layout/view_sports_card" />
    </FrameLayout>

    <!-- CENTER: Google News RSS Ticker / Top Shelf Pill -->
    <FrameLayout
        android:id="@+id/widget_news_container"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="164dp"
        android:background="@drawable/bg_capsule_pill"
        android:clickable="false"
        android:descendantFocusability="blocksDescendants"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <TextView
            android:id="@+id/text_widget_news"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="false"
            android:ellipsize="marquee"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="20dp"
            android:focusable="false"
            android:fontFamily="sans-serif-medium"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxWidth="820dp"
            android:singleLine="true"
            android:textColor="#F0FFFFFF"
            android:textSize="14sp"
            tools:text="Google News : Découverte majeure dans l'exploration spatiale..." />
    </FrameLayout>

    <!-- BOTTOM DOCK SHELF: Exactly 5 Widescreen Favorite Apps pinned at bottom -->
    <FrameLayout
        android:id="@+id/dock_shelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_tvos_dock"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="10dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_favorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:nextFocusDown="@id/recycler_drawer"
            android:nextFocusUp="@id/btn_settings"
            android:orientation="horizontal"
            android:overScrollMode="never"
            tools:listitem="@layout/item_app_card" />

    </FrameLayout>

    <!-- ======================================================== -->
    <!-- TIER 2: ALL APPS DRAWER GRID                             -->
    <!-- Hidden at rest (View.GONE), opens on DOWN arrow from dock-->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/drawer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="14dp"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingTop="12dp"
        android:paddingEnd="44dp"
        android:paddingBottom="36dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_drawer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="Toutes les applications"
            android:textColor="#E0FFFFFF"
            android:textSize="17sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:nextFocusUp="@id/recycler_favorites"
            android:overScrollMode="never"
            tools:listitem="@layout/item_app_card" />

    </LinearLayout>

    <!-- ======================================================== -->
    <!-- TVOS CONTROL CENTER (Centre de Contrôle Apple TV)        -->
    <!-- Lateral floating translucent rounded panel               -->
    <!-- ======================================================== -->
    <include layout="@layout/view_control_center" />

    <!-- Loader -->
    <ProgressBar
        android:id="@+id/progress_loader"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:elevation="35dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/focus_glow_apple"
        android:visibility="gone" />

</FrameLayout>
