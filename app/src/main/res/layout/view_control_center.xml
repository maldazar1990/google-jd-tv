<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/control_center_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:elevation="28dp"
    android:focusable="false"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/control_center_panel"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_control_center_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="20dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- En-tête compact et minimal sans chevauchement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Centre de contrôle"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="JD TV"
                android:textColor="#66FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Ligne 1 : Grille 2x2 tvOS : Alimentation (Veille & HDMI-CEC) + Statuts (Wi-Fi & Manette) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_marginBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <!-- Colonne Gauche : Veille (Haut) et Éteindre TV HDMI-CEC (Bas) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <!-- Veille Daydream Google TV -->
                <LinearLayout
                    android:id="@+id/btn_cc_power"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_control_center_item_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@+id/btn_cc_cec_power"
                    android:nextFocusLeft="@+id/btn_cc_power"
                    android:nextFocusRight="@+id/btn_cc_wifi"
                    android:nextFocusUp="@+id/btn_cc_power"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/icon_cc_power"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_power"
                        app:tint="@color/color_cc_icon_tint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_cc_power_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="Veille"
                            android:textColor="@color/color_cc_item_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:singleLine="true"
                            android:text="Écran de veille"
                            android:textColor="@color/color_cc_item_subtext"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Éteindre TV (HDMI-CEC) -->
                <LinearLayout
                    android:id="@+id/btn_cc_cec_power"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_center_item_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@+id/btn_cc_all_settings"
                    android:nextFocusLeft="@+id/btn_cc_cec_power"
                    android:nextFocusRight="@+id/btn_cc_remote_battery"
                    android:nextFocusUp="@+id/btn_cc_power"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/icon_cc_cec_power"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_display"
                        app:tint="@color/color_cc_icon_tint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="Éteindre TV"
                            android:textColor="@color/color_cc_item_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:singleLine="true"
                            android:text="HDMI-CEC"
                            android:textColor="@color/color_cc_item_subtext"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Colonne Droite : Wi-Fi (Haut) et Télécommande & Batterie (Bas) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <!-- Wi-Fi -->
                <LinearLayout
                    android:id="@+id/btn_cc_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_control_center_item_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@+id/btn_cc_remote_battery"
                    android:nextFocusLeft="@+id/btn_cc_power"
                    android:nextFocusRight="@+id/btn_cc_wifi"
                    android:nextFocusUp="@+id/btn_cc_wifi"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/icon_cc_wifi"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_wifi"
                        app:tint="@color/color_cc_icon_tint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_cc_wifi_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="Wi-Fi"
                            android:textColor="@color/color_cc_item_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_cc_wifi_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:singleLine="true"
                            android:text="Connecté"
                            android:textColor="@color/color_cc_item_subtext"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Télécommande / Manette & Niveau de Batterie -->
                <LinearLayout
                    android:id="@+id/btn_cc_remote_battery"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_center_item_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@+id/btn_cc_close"
                    android:nextFocusLeft="@+id/btn_cc_cec_power"
                    android:nextFocusRight="@+id/btn_cc_remote_battery"
                    android:nextFocusUp="@+id/btn_cc_wifi"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/icon_cc_remote"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_gamepad"
                        app:tint="@color/color_cc_icon_tint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_cc_remote_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:text="Télécommande"
                            android:textColor="@color/color_cc_item_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_cc_remote_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:singleLine="true"
                            android:text="Connectée"
                            android:textColor="@color/color_cc_item_subtext"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Pastille rouge alerte [!] si batterie <= 20% -->
                    <FrameLayout
                        android:id="@+id/badge_cc_remote_low_battery"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_cc_battery_low_badge"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="!"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Ligne 2 : Rangée d'icônes rondes en bas (Réglages Zen TV, Accessibilité, Fermer) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <!-- Réglages JD TV -->
            <FrameLayout
                android:id="@+id/btn_cc_all_settings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_control_center_circle_selector"
                android:clickable="true"
                android:contentDescription="Réglages JD TV"
                android:focusable="true"
                android:nextFocusDown="@+id/btn_cc_all_settings"
                android:nextFocusLeft="@+id/btn_cc_all_settings"
                android:nextFocusRight="@+id/btn_cc_accessibility"
                android:nextFocusUp="@+id/btn_cc_cec_power">

                <ImageView
                    android:id="@+id/icon_cc_settings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/color_cc_icon_tint" />
            </FrameLayout>

            <!-- Accessibilité -->
            <FrameLayout
                android:id="@+id/btn_cc_accessibility"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_control_center_circle_selector"
                android:clickable="true"
                android:contentDescription="Accessibilité"
                android:focusable="true"
                android:nextFocusDown="@+id/btn_cc_accessibility"
                android:nextFocusLeft="@+id/btn_cc_all_settings"
                android:nextFocusRight="@+id/btn_cc_close"
                android:nextFocusUp="@+id/btn_cc_cec_power">

                <ImageView
                    android:id="@+id/icon_cc_accessibility"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_accessibility"
                    app:tint="@color/color_cc_icon_tint" />
            </FrameLayout>

            <!-- Fermer -->
            <FrameLayout
                android:id="@+id/btn_cc_close"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_control_center_circle_selector"
                android:clickable="true"
                android:contentDescription="Fermer"
                android:focusable="true"
                android:nextFocusDown="@+id/btn_cc_close"
                android:nextFocusLeft="@+id/btn_cc_accessibility"
                android:nextFocusRight="@+id/btn_cc_close"
                android:nextFocusUp="@+id/btn_cc_remote_battery">

                <ImageView
                    android:id="@+id/icon_cc_close"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_close"
                    app:tint="@color/color_cc_icon_tint" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
