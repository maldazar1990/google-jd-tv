<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/control_center_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:elevation="28dp"
    android:focusable="false"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/control_center_panel"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_control_center_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="20dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- En-tête compact et minimal sans chevauchement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Centre de contrôle"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Zen TV"
                android:textColor="#66FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Ligne 1 : Bouton Veille (carré gauche) + Stack Wi-Fi & Audio (droite) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:layout_marginBottom="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <!-- Grand bouton carré Veille / Eteindre -->
            <LinearLayout
                android:id="@+id/btn_cc_power"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_control_center_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/layout_cc_volume_slider"
                android:nextFocusLeft="@+id/btn_cc_power"
                android:nextFocusRight="@+id/btn_cc_wifi"
                android:nextFocusUp="@+id/btn_cc_power"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/icon_cc_power"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_power"
                    app:tint="@color/color_cc_icon_tint" />

                <TextView
                    android:id="@+id/text_cc_power_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="Veille"
                    android:textColor="@color/color_cc_item_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stack vertical droite : Wi-Fi (haut) et Audio & Son (bas) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:orientation="vertical">

                <!-- Wi-Fi -->
                <LinearLayout
                    android:id="@+id/btn_cc_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_control_center_item_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@+id/btn_cc_audio"
                    android:nextFocusLeft="@+id/btn_cc_power"
                    android:nextFocusRight="@+id/btn_cc_wifi"
                    android:nextFocusUp="@+id/btn_cc_wifi"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/icon_cc_wifi"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_wifi"
                        app:tint="@color/color_cc_icon_tint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_cc_wifi_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="Wi-Fi"
                            android:textColor="@color/color_cc_item_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_cc_wifi_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:singleLine="true"
                            android:text="Connecté"
                            android:textColor="@color/color_cc_item_subtext"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Audio & Son : Accès direct aux réglages audio système -->
                <LinearLayout
                    android:id="@+id/btn_cc_audio"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_center_item_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@+id/layout_cc_volume_slider"
                    android:nextFocusLeft="@+id/btn_cc_power"
                    android:nextFocusRight="@+id/btn_cc_audio"
                    android:nextFocusUp="@+id/btn_cc_wifi"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/icon_cc_audio"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_volume"
                        app:tint="@color/color_cc_icon_tint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_cc_audio_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="Audio &amp; Son"
                            android:textColor="@color/color_cc_item_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_cc_audio_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:singleLine="true"
                            android:text="Haut-parleurs TV"
                            android:textColor="@color/color_cc_item_subtext"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Range Slider Interactif Contrôle Sonore en Temps Réel -->
        <LinearLayout
            android:id="@+id/layout_cc_volume_slider"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_control_center_item_selector"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@+id/btn_cc_close"
            android:nextFocusLeft="@+id/layout_cc_volume_slider"
            android:nextFocusRight="@+id/layout_cc_volume_slider"
            android:nextFocusUp="@+id/btn_cc_power"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/icon_cc_volume_slider"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_volume"
                app:tint="@color/color_cc_icon_tint" />

            <ProgressBar
                android:id="@+id/progress_cc_volume"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:max="100"
                android:progress="70"
                android:progressDrawable="@drawable/bg_cc_volume_progress" />

            <TextView
                android:id="@+id/text_cc_volume_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:text="70%"
                android:textColor="@color/color_cc_item_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Section Dynamique Bluetooth (Casque ou Manette connectés avec batterie/volume) -->
        <LinearLayout
            android:id="@+id/layout_cc_connected_bluetooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_control_center_item_selector"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@+id/btn_cc_accessibility"
            android:nextFocusLeft="@+id/layout_cc_connected_bluetooth"
            android:nextFocusRight="@+id/layout_cc_connected_bluetooth"
            android:nextFocusUp="@+id/layout_cc_volume_slider"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/icon_cc_bt_device"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_gamepad"
                app:tint="@color/color_cc_icon_tint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:duplicateParentState="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_cc_bt_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/color_cc_item_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Xbox Wireless Controller" />

                <TextView
                    android:id="@+id/text_cc_bt_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:singleLine="true"
                    android:textColor="@color/color_cc_item_subtext"
                    android:textSize="11sp"
                    tools:text="Batterie : 85%" />
            </LinearLayout>

            <!-- Badge rouge Alerte Batterie Faible (<= 20%) avec [!] blanc en gras -->
            <FrameLayout
                android:id="@+id/badge_cc_bt_low_battery"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_cc_battery_low_badge"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="!"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Ligne 3 : Rangée d'icônes rondes en bas (Réglages Zen TV, Accessibilité, Fermer) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <!-- Réglages Zen TV -->
            <FrameLayout
                android:id="@+id/btn_cc_all_settings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_control_center_circle_selector"
                android:clickable="true"
                android:contentDescription="Réglages Zen TV"
                android:focusable="true"
                android:nextFocusDown="@+id/btn_cc_all_settings"
                android:nextFocusLeft="@+id/btn_cc_all_settings"
                android:nextFocusRight="@+id/btn_cc_accessibility"
                android:nextFocusUp="@+id/layout_cc_volume_slider">

                <ImageView
                    android:id="@+id/icon_cc_settings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/color_cc_icon_tint" />
            </FrameLayout>

            <!-- Accessibilité -->
            <FrameLayout
                android:id="@+id/btn_cc_accessibility"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_control_center_circle_selector"
                android:clickable="true"
                android:contentDescription="Accessibilité"
                android:focusable="true"
                android:nextFocusDown="@+id/btn_cc_accessibility"
                android:nextFocusLeft="@+id/btn_cc_all_settings"
                android:nextFocusRight="@+id/btn_cc_close"
                android:nextFocusUp="@+id/layout_cc_volume_slider">

                <ImageView
                    android:id="@+id/icon_cc_accessibility"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_accessibility"
                    app:tint="@color/color_cc_icon_tint" />
            </FrameLayout>

            <!-- Fermer -->
            <FrameLayout
                android:id="@+id/btn_cc_close"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_control_center_circle_selector"
                android:clickable="true"
                android:contentDescription="Fermer"
                android:focusable="true"
                android:nextFocusDown="@+id/btn_cc_close"
                android:nextFocusLeft="@+id/btn_cc_accessibility"
                android:nextFocusRight="@+id/btn_cc_close"
                android:nextFocusUp="@+id/layout_cc_volume_slider">

                <ImageView
                    android:id="@+id/icon_cc_close"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_close"
                    app:tint="@color/color_cc_icon_tint" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
